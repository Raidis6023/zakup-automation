# Run Nginx on the physical host (no third-party proxy or VPN).
# Copy this template only AFTER real TLS certificate files exist.
# Use your actual address in the TLS certificate SAN (domain or public IP).
# Publicly expose only TCP 443 (+ optional 80 for validation/redirect).
#
# The Next.js app listens on host loopback 127.0.0.1:3000.
# The self-hosted Supabase API gateway listens on host loopback 127.0.0.1:8000.

map $http_upgrade $panda_connection_upgrade {
    default upgrade;
    '' close;
}

server {
    listen 80;
    server_name _;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name _;
    server_tokens off;
    ssl_certificate /etc/ssl/panda/fullchain.pem;
    ssl_certificate_key /etc/ssl/panda/privkey.pem;

    client_max_body_size 55m;
    proxy_connect_timeout 10s;
    proxy_send_timeout 360s;
    proxy_read_timeout 360s;

    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-Host $http_host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Real-IP $remote_addr;

    # Public Supabase paths only. Do not publish Studio or admin endpoints.
    location ~ ^/(auth/v1|rest/v1|storage/v1|realtime/v1|functions/v1)(/|$) {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $panda_connection_upgrade;
        proxy_buffering off;
    }

    # Next.js frontend + business routes.
    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $panda_connection_upgrade;
    }
}
