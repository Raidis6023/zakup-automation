# EXAMPLE ONLY: copy to .env.docker (ignored by Git).
# Supply browser-accessible URL of the self-hosted Supabase gateway.
# The Docker service name is NOT accessible to users' browsers.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only bootstrap credential for the Supabase application.
# In production, provide via a controlled secret mechanism, not GitHub.
SUPABASE_SECRET_KEY=

# Never commit or paste real secret values.
CRON_SECRET=

# Optional external integrations used by selected features.
GOOGLE_SHEETS_CLIENT_EMAIL=
GOOGLE_SHEETS_PRIVATE_KEY=

# Service-scoped 1C export authorization.
ONE_C_API_KEY_SHA256=
ONE_C_API_SCOPES=finance,sales,products,stocks

# Marketplace secrets are managed from the PАНДА admin interface / encrypted
# server storage. Do not duplicate them here as a long-term setup.
